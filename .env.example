# ============================================================
# AI Support Chatbot — Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Application ---
APP_ENV=development                        # development | production | testing
APP_NAME="AI Support Chatbot"
APP_VERSION=1.0.0
LOG_LEVEL=INFO                             # DEBUG | INFO | WARNING | ERROR

# --- Security ---
SECRET_KEY=your-very-long-random-secret-key-here-min-32-chars
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-strong-password

# --- LLM Provider (OpenAI) ---
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1  # Override for Groq, Ollama, etc.
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# --- Embeddings ---
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# Set EMBEDDING_PROVIDER=local to use sentence-transformers (no API needed)
EMBEDDING_PROVIDER=openai

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://chatbot_user:chatbot_password@localhost:5432/chatbot_db
# For sync operations (Alembic migrations):
DATABASE_SYNC_URL=postgresql+psycopg2://chatbot_user:chatbot_password@localhost:5432/chatbot_db

# --- CORS ---
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000

# --- RAG Retrieval ---
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.70
RAG_MAX_CONTEXT_CHUNKS=4

# --- Session ---
SESSION_EXPIRE_MINUTES=60
SESSION_ALGORITHM=HS256

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_CHAT_PER_MINUTE=10
RATE_LIMIT_UPLOAD_PER_MINUTE=5

# --- Request Limits ---
MAX_QUESTION_LENGTH=2000
MAX_UPLOAD_SIZE_MB=10
MAX_CONVERSATION_HISTORY=20

# --- Handoff / Support Integration ---
# Leave HANDOFF_EMAIL_TO empty to disable email notifications (requests still stored in DB)
HANDOFF_EMAIL_TO=
HANDOFF_EMAIL_FROM=noreply@yourdomain.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=true

# --- Analytics ---
ANALYTICS_RETENTION_DAYS=90

# --- Local Development Overrides ---
# DEV_SKIP_AUTH=false     # Never set to true in production
